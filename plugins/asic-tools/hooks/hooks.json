{
  "description": "Captain ASIC hard-rule enforcement: deny AI-attributed commits, pushes in any form, and hook bypass; ask before destructive git and before committing to main; restate rule precedence each turn.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/precedence-inject.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
